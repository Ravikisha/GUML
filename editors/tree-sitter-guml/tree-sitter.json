{
  "grammars": [
    {
      "name": "guml",
      "camelcase": "Guml",
      "scope": "source.guml",
      "path": ".",
      "file-types": [
        "guml"
      ],
      "injection-regex": "^guml$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "tree-sitter grammar for GUML",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-guml"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
