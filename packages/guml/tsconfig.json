{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    // The test file is run by `node --test` straight from source, so it imports
    // `./eval.ts` by its real extension.
    "allowImportingTsExtensions": true,
    "types": ["react", "node"]
  },
  "include": ["src", "wasm/*.d.ts"]
}
