{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:deps && next dev",
    "build": "pnpm build:deps && node scripts/gen-fixtures.mjs && next build",
    "build:deps": "pnpm --filter @guml/core build:ts && pnpm --filter @guml/highlight build",
    "start": "next start",
    "lint": "eslint",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "gen:theme": "node scripts/gen-theme-classes.mjs",
    "check:theme": "node scripts/gen-theme-classes.mjs --check",
    "check:highlight": "node --experimental-strip-types --no-warnings scripts/check-highlight-parity.mjs",
    "check:previews": "node --experimental-strip-types --no-warnings scripts/check-doc-previews.mjs",
    "typecheck": "pnpm build:deps && tsc --noEmit",
    "check:packages": "node --experimental-strip-types --no-warnings scripts/check-packages.mjs",
    "check:a11y": "node scripts/check-a11y.mjs"
  },
  "dependencies": {
    "@guml/core": "workspace:*",
    "@guml/highlight": "workspace:*",
    "@radix-ui/react-tabs": "^1.1.21",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "node-html-parser": "^9.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
