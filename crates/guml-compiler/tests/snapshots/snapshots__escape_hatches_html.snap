---
source: crates/guml-compiler/tests/snapshots.rs
expression: "emitted(\"d.guml\", \"html\")"
---
// ---- Spend.html ----
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Spend</title>
    <style>
      /* shadcn/ui as plain CSS, for the static-HTML backend.
       *
       * # Why this file exists at all
       *
       * The React and Svelte backends emit class names and the host's own Tailwind pipeline resolves them. The
       * static-HTML backend has **no build step** — that is the point of it — so it cannot run a utility-class
       * compiler, and a themed no-JavaScript document would be completely unstyled without this. Every class the
       * theme emits has a rule here, enforced by `every_class_the_builtin_theme_emits_has_a_rule_in_its_stylesheet`.
       * A missing rule is a silent, purely visual failure, which is exactly the kind a test has to catch.
       *
       * # The tokens are shadcn's, verbatim
       *
       * `--background`/`--foreground` pairs, `--primary`, `--secondary`, `--muted`, `--accent`, `--destructive`,
       * `--border`, `--input`, `--ring`, `--card`, `--popover`, `--sidebar`, `--radius`, in `oklch` — the neutral
       * default from shadcn's theming docs. A host that already runs shadcn can delete the `:root` block below and
       * its own palette applies unchanged, because the variables *are* the interface. That is the whole reason to
       * theme in tokens rather than in colour literals.
       *
       * # What this is not
       *
       * Not Tailwind. It implements the ~160 utilities this theme actually uses and nothing else, so it stays
       * readable and auditable. Add a utility to `shadcn.json` and the test above tells you to add it here too.
       */
      
      :root {
        --background: oklch(1 0 0);
        --foreground: oklch(0.145 0 0);
        --card: oklch(1 0 0);
        --card-foreground: oklch(0.145 0 0);
        --popover: oklch(1 0 0);
        --popover-foreground: oklch(0.145 0 0);
        --primary: oklch(0.205 0 0);
        --primary-foreground: oklch(0.985 0 0);
        --secondary: oklch(0.97 0 0);
        --secondary-foreground: oklch(0.205 0 0);
        --muted: oklch(0.97 0 0);
        --muted-foreground: oklch(0.556 0 0);
        --accent: oklch(0.97 0 0);
        --accent-foreground: oklch(0.205 0 0);
        --destructive: oklch(0.577 0.245 27.325);
        --destructive-foreground: oklch(0.985 0 0);
        --border: oklch(0.922 0 0);
        --input: oklch(0.922 0 0);
        --ring: oklch(0.708 0 0);
        --sidebar: oklch(0.985 0 0);
        --sidebar-foreground: oklch(0.145 0 0);
        --radius: 0.625rem;
      }
      
      /* Both signals, because the viewer's system preference and an explicit toggle are different things and a
       * page should honour whichever it is given. */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --background: oklch(0.145 0 0);
          --foreground: oklch(0.985 0 0);
          --card: oklch(0.205 0 0);
          --card-foreground: oklch(0.985 0 0);
          --popover: oklch(0.269 0 0);
          --popover-foreground: oklch(0.985 0 0);
          --primary: oklch(0.922 0 0);
          --primary-foreground: oklch(0.205 0 0);
          --secondary: oklch(0.269 0 0);
          --secondary-foreground: oklch(0.985 0 0);
          --muted: oklch(0.269 0 0);
          --muted-foreground: oklch(0.708 0 0);
          --accent: oklch(0.371 0 0);
          --accent-foreground: oklch(0.985 0 0);
          --destructive: oklch(0.704 0.191 22.216);
          --destructive-foreground: oklch(0.985 0 0);
          --border: oklch(1 0 0 / 10%);
          --input: oklch(1 0 0 / 15%);
          --ring: oklch(0.556 0 0);
          --sidebar: oklch(0.205 0 0);
          --sidebar-foreground: oklch(0.985 0 0);
        }
      }
      
      :root[data-theme="dark"] {
        --background: oklch(0.145 0 0);
        --foreground: oklch(0.985 0 0);
        --card: oklch(0.205 0 0);
        --card-foreground: oklch(0.985 0 0);
        --popover: oklch(0.269 0 0);
        --popover-foreground: oklch(0.985 0 0);
        --primary: oklch(0.922 0 0);
        --primary-foreground: oklch(0.205 0 0);
        --secondary: oklch(0.269 0 0);
        --secondary-foreground: oklch(0.985 0 0);
        --muted: oklch(0.269 0 0);
        --muted-foreground: oklch(0.708 0 0);
        --accent: oklch(0.371 0 0);
        --accent-foreground: oklch(0.985 0 0);
        --destructive: oklch(0.704 0.191 22.216);
        --destructive-foreground: oklch(0.985 0 0);
        --border: oklch(1 0 0 / 10%);
        --input: oklch(1 0 0 / 15%);
        --ring: oklch(0.556 0 0);
        --sidebar: oklch(0.205 0 0);
        --sidebar-foreground: oklch(0.985 0 0);
      }
      
      /* ------------------------------------------------------------------ reset
       *
       * Small and load-bearing. Without `box-sizing: border-box` every padded utility in this file computes the
       * wrong width, and without `body { margin: 0 }` the page has a browser default gutter no utility removes.
       * `html_backend.rs` asserts a reset is present, because a no-build-step page has nowhere else to get one.
       *
       * The base surface is set from the tokens here rather than on `<body>`'s class list, so a document with no
       * background utility of its own still gets the theme's — and gets the dark variant for free. */
      
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      
      body {
        margin: 0;
        background-color: var(--background);
        color: var(--foreground);
        /* shadcn's own stack: system UI first, so a page looks native before any webfont loads. */
        font-family:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      
      /* ------------------------------------------------------------------ colour */
      
      .bg-background { background-color: var(--background); }
      .bg-card { background-color: var(--card); }
      .bg-popover { background-color: var(--popover); }
      .bg-primary { background-color: var(--primary); }
      .bg-secondary { background-color: var(--secondary); }
      .bg-muted { background-color: var(--muted); }
      .bg-accent { background-color: var(--accent); }
      .bg-destructive { background-color: var(--destructive); }
      .bg-border { background-color: var(--border); }
      .bg-input { background-color: var(--input); }
      .bg-sidebar { background-color: var(--sidebar); }
      .bg-transparent { background-color: transparent; }
      /* `color-mix` rather than a second variable: shadcn writes `bg-primary/20` and the opacity belongs to the
       * utility, not to the token. */
      .bg-primary\/20 { background-color: color-mix(in oklab, var(--primary) 20%, transparent); }
      
      .text-foreground { color: var(--foreground); }
      .text-card-foreground { color: var(--card-foreground); }
      .text-popover-foreground { color: var(--popover-foreground); }
      .text-primary { color: var(--primary); }
      .text-primary-foreground { color: var(--primary-foreground); }
      .text-secondary-foreground { color: var(--secondary-foreground); }
      .text-muted-foreground { color: var(--muted-foreground); }
      .text-destructive { color: var(--destructive); }
      .text-destructive-foreground { color: var(--destructive-foreground); }
      .text-sidebar-foreground { color: var(--sidebar-foreground); }
      
      .border { border-width: 1px; border-style: solid; border-color: var(--border); }
      .border-0 { border-width: 0; }
      .border-b { border-bottom-width: 1px; border-bottom-style: solid; border-color: var(--border); }
      .border-t { border-top-width: 1px; border-top-style: solid; border-color: var(--border); }
      .border-l { border-left-width: 1px; border-left-style: solid; border-color: var(--border); }
      .border-border { border-color: var(--border); }
      .border-input { border-color: var(--input); }
      .border-transparent { border-color: transparent; }
      .border-destructive\/50 { border-color: color-mix(in oklab, var(--destructive) 50%, transparent); }
      .border-collapse { border-collapse: collapse; }
      
      .divide-y > * + * { border-top-width: 1px; border-top-style: solid; }
      .divide-border > * + * { border-color: var(--border); }
      
      /* ------------------------------------------------------------------ focus, hover, disabled */
      
      /* shadcn v4's focus treatment: a 3px ring at half opacity plus a border colour change. `:focus-visible`
       * rather than `:focus`, which is what keeps a ring off a mouse click and on a keyboard tab. */
      .focus-visible\:border-ring:focus-visible { border-color: var(--ring); }
      .focus-visible\:ring-\[3px\]:focus-visible { box-shadow: 0 0 0 3px var(--guml-ring, transparent); }
      .focus-visible\:ring-ring\/50:focus-visible { --guml-ring: color-mix(in oklab, var(--ring) 50%, transparent); }
      .outline-none { outline: 2px solid transparent; outline-offset: 2px; }
      
      .hover\:bg-primary\/90:hover { background-color: color-mix(in oklab, var(--primary) 90%, transparent); }
      .hover\:bg-secondary\/80:hover { background-color: color-mix(in oklab, var(--secondary) 80%, transparent); }
      .hover\:bg-destructive\/90:hover { background-color: color-mix(in oklab, var(--destructive) 90%, transparent); }
      .hover\:bg-accent:hover { background-color: var(--accent); }
      .hover\:text-accent-foreground:hover { color: var(--accent-foreground); }
      .hover\:underline:hover { text-decoration-line: underline; }
      
      /* Disabled is opacity *and* pointer-events, so it is not conveyed by colour alone — which is the contract
       * `Theme::validate` reads. */
      .disabled\:opacity-50:disabled { opacity: 0.5; }
      .disabled\:pointer-events-none:disabled { pointer-events: none; }
      
      /* ------------------------------------------------------------------ layout */
      
      .flex { display: flex; }
      .inline-flex { display: inline-flex; }
      .grid { display: grid; }
      .block { display: block; }
      .flex-col { flex-direction: column; }
      .flex-wrap { flex-wrap: wrap; }
      .flex-1 { flex: 1 1 0%; }
      .shrink-0 { flex-shrink: 0; }
      .items-center { align-items: center; }
      .items-start { align-items: flex-start; }
      .justify-center { justify-content: center; }
      .justify-between { justify-content: space-between; }
      .justify-end { justify-content: flex-end; }
      .relative { position: relative; }
      .fixed { position: fixed; }
      .inset-y-0 { top: 0; bottom: 0; }
      .top-1\/2 { top: 50%; }
      .left-1\/2 { left: 50%; }
      .right-0 { right: 0; }
      .right-6 { right: 1.5rem; }
      .bottom-6 { bottom: 1.5rem; }
      .z-50 { z-index: 50; }
      .-translate-x-1\/2 { transform: translateX(-50%); }
      /* Both translate utilities on one element have to compose, so the pair is declared together as well. */
      .-translate-y-1\/2 { transform: translateY(-50%); }
      .-translate-x-1\/2.-translate-y-1\/2 { transform: translate(-50%, -50%); }
      .overflow-hidden { overflow: hidden; }
      .caption-bottom { caption-side: bottom; }
      .align-middle { vertical-align: middle; }
      .whitespace-nowrap { white-space: nowrap; }
      .tabular-nums { font-variant-numeric: tabular-nums; }
      .peer { }
      .m-0 { margin: 0; }
      .mx-auto { margin-left: auto; margin-right: auto; }
      .ml-0 { margin-left: 0; }
      .my-4 { margin-top: 1rem; margin-bottom: 1rem; }
      .mt-1 { margin-top: 0.25rem; }
      .mt-6 { margin-top: 1.5rem; }
      .mt-8 { margin-top: 2rem; }
      .mt-10 { margin-top: 2.5rem; }
      .mt-12 { margin-top: 3rem; }
      .mt-16 { margin-top: 4rem; }
      .pb-2 { padding-bottom: 0.5rem; }
      .pb-3 { padding-bottom: 0.75rem; }
      .pb-4 { padding-bottom: 1rem; }
      .pt-6 { padding-top: 1.5rem; }
      .p-2 { padding: 0.5rem; }
      .p-4 { padding: 1rem; }
      .p-6 { padding: 1.5rem; }
      .px-2 { padding-left: 0.5rem; padding-right: 0.5rem; }
      .px-3 { padding-left: 0.75rem; padding-right: 0.75rem; }
      .px-4 { padding-left: 1rem; padding-right: 1rem; }
      .px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }
      .py-0\.5 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
      .py-1 { padding-top: 0.25rem; padding-bottom: 0.25rem; }
      .py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
      .py-3 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
      .gap-1 { gap: 0.25rem; }
      .gap-1\.5 { gap: 0.375rem; }
      .gap-2 { gap: 0.5rem; }
      .gap-4 { gap: 1rem; }
      .gap-6 { gap: 1.5rem; }
      .scroll-m-20 { scroll-margin: 5rem; }
      .scroll-mt-16 { scroll-margin-top: 4rem; }
      
      /* ------------------------------------------------------------------ size */
      
      .h-2 { height: 0.5rem; }
      .h-6 { height: 1.5rem; }
      .h-8 { height: 2rem; }
      .h-9 { height: 2.25rem; }
      .h-10 { height: 2.5rem; }
      .h-12 { height: 3rem; }
      .h-px { height: 1px; }
      .h-full { height: 100%; }
      .h-\[1\.15rem\] { height: 1.15rem; }
      .w-8 { width: 2rem; }
      .w-full { width: 100%; }
      .w-fit { width: fit-content; }
      .w-3\/4 { width: 75%; }
      .min-w-0 { min-width: 0; }
      .max-w-full { max-width: 100%; }
      .max-w-sm { max-width: 24rem; }
      .max-w-lg { max-width: 32rem; }
      .size-4 { width: 1rem; height: 1rem; }
      .size-8 { width: 2rem; height: 2rem; }
      
      /* ------------------------------------------------------------------ radius, shadow, motion */
      
      /* Every radius derives from `--radius`, which is how a shadcn host retunes corner rounding in one place. */
      .rounded-md { border-radius: calc(var(--radius) - 2px); }
      .rounded-lg { border-radius: var(--radius); }
      .rounded-xl { border-radius: calc(var(--radius) + 4px); }
      .rounded-full { border-radius: 9999px; }
      .rounded-\[4px\] { border-radius: 4px; }
      
      .shadow-xs { box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); }
      .shadow-sm { box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1); }
      .shadow-lg { box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1); }
      
      .transition-all { transition-property: all; transition-duration: 150ms; }
      .transition-colors { transition-property: color, background-color, border-color; transition-duration: 150ms; }
      .transition-shadow { transition-property: box-shadow; transition-duration: 150ms; }
      
      /* `prefers-reduced-motion` is honoured, because a pulsing skeleton is exactly what that preference is for
       * and a compiler that owns presentation owns this too. */
      @keyframes guml-pulse {
        50% { opacity: 0.5; }
      }
      .animate-pulse { animation: guml-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
      @media (prefers-reduced-motion: reduce) {
        .animate-pulse { animation: none; }
        .transition-all,
        .transition-colors,
        .transition-shadow { transition-duration: 0s; }
      }
      
      /* ------------------------------------------------------------------ type */
      
      .text-xs { font-size: 0.75rem; line-height: 1rem; }
      .text-sm { font-size: 0.875rem; line-height: 1.25rem; }
      .text-base { font-size: 1rem; line-height: 1.5rem; }
      .text-2xl { font-size: 1.5rem; line-height: 2rem; }
      .text-3xl { font-size: 1.875rem; line-height: 2.25rem; }
      .text-4xl { font-size: 2.25rem; line-height: 2.5rem; }
      .text-5xl { font-size: 3rem; line-height: 1; }
      .font-medium { font-weight: 500; }
      .font-semibold { font-weight: 600; }
      .font-bold { font-weight: 700; }
      .font-extrabold { font-weight: 800; }
      .leading-7 { line-height: 1.75rem; }
      .tracking-tight { letter-spacing: -0.025em; }
      .text-center { text-align: center; }
      .text-left { text-align: left; }
      .underline-offset-4 { text-underline-offset: 4px; }
      .placeholder\:text-muted-foreground::placeholder { color: var(--muted-foreground); }
      
      /* ------------------------------------------------------------------ responsive */
      
      @media (min-width: 768px) {
        .md\:text-sm { font-size: 0.875rem; line-height: 1.25rem; }
      }
      @media (min-width: 640px) {
        .sm\:max-w-sm { max-width: 24rem; }
      }
      
      /* Emitted by `cols=N` on a grid. Enumerated rather than generated, for the same reason the rest of this file
       * is: there is no build step here to generate anything. */
      @media (min-width: 768px) {
        .md\:grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
        .md\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .md\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .md\:grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .md\:grid-cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
        .md\:grid-cols-6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
      }
    </style>
  </head>
  <body>
    <main class="mx-auto max-w-3xl p-6">
      <p class="text-2xl font-semibold tracking-tight text-foreground">Spend — 0 entries</p>
      <p class="mt-10 text-center text-sm text-slate-500" data-guml-inert="no data at build time">Nothing here yet.</p>
      <p class="leading-7 text-foreground">Totals are formatted by a `js` block, because currency formatting is not something the</p>
      <p class="leading-7 text-foreground">vocabulary should try to own.</p>
    </main>
  </body>
</html>
