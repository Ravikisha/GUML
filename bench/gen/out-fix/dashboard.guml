page SalesDashboard

type Order {id, customer, amount:number, status}
data orders:Order[] GET /api/orders
  filter POST /api/orders {status} optimistic:prepend

state filter=new|shipped|refunded
state draft=""

head Sales Dashboard — {orders.count} orders

row between
  metric {orders.count} "Orders"
  metric {orders.amount.sum} "$ Total"
  metric {orders.where(status="new").count} "New"
  metric {orders.where(status="refunded").count} "Refunded"

tabs filter

table orders where={filter}
  text {customer}
  text {amount}
  text {status}
  empty No orders match this filter.
