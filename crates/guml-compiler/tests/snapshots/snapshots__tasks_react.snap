// ---- Tasks.tsx ----
import { useState, useCallback, useEffect, useMemo } from "react";

type Task = { id: string; title: string; done: boolean; createdAt: string };

/**
 * `fetch` with exponential backoff. Generated by the GUML compiler.
 *
 * Retries only what is safe to repeat — idempotent methods, and only on a transport failure or a 5xx.
 * A 4xx will answer the same way next time, and an abort means the caller no longer wants the answer.
 */
async function retrying(url: string, init: RequestInit = {}, tries = 3): Promise<Response> {
  const idempotent = !init.method || ["GET", "HEAD", "PUT", "DELETE"].includes(init.method);
  let wait = 300;
  for (let attempt = 1; ; attempt++) {
    const last = attempt >= tries || !idempotent;
    try {
      const res = await fetch(url, init);
      if (res.ok || res.status < 500 || last) return res;
    } catch (err) {
      if (last || (err instanceof Error && err.name === "AbortError")) throw err;
    }
    await new Promise((resolve) => setTimeout(resolve, wait));
    wait *= 2;
  }
}

/**
 * Response cache. Generated by the GUML compiler.
 *
 * In-flight deduplication, stale-while-revalidate, invalidation on mutation, and stale-on-failure —
 * the four things every application needs from a fetch layer and nobody writes on the first pass.
 * Only GET is cached; a cached POST would hand one caller another's response.
 */
const GUML_CACHE = new Map<string, { at: number; data: unknown }>();
const GUML_INFLIGHT = new Map<string, Promise<unknown>>();
/** How long a cached response is served without revalidating behind it. */
const GUML_STALE_MS = 30_000;

/** Drop every cached entry whose URL starts with `prefix`. Called after a mutation. */
function invalidate(prefix: string): void {
  for (const key of [...GUML_CACHE.keys()]) {
    if (key.slice(key.indexOf(" ") + 1).startsWith(prefix)) GUML_CACHE.delete(key);
  }
}

async function cached<T>(url: string, init: RequestInit = {}): Promise<T> {
  const method = init.method ?? "GET";
  const key = `${method} ${url}`;
  if (method !== "GET") return read<T>(url, init);

  const hit = GUML_CACHE.get(key);
  const fresh = hit && Date.now() - hit.at < GUML_STALE_MS;
  if (hit && !fresh) {
    // Stale: revalidate behind the value we are about to return. Errors are swallowed here on purpose —
    // the caller already has data, and a background refresh failing is not the caller's problem.
    void refresh<T>(key, url, init).catch(() => {});
  }
  if (hit) return hit.data as T;

  const pending = GUML_INFLIGHT.get(key);
  if (pending) return pending as Promise<T>;
  return refresh<T>(key, url, init);
}

function refresh<T>(key: string, url: string, init: RequestInit): Promise<T> {
  const request = read<T>(url, init)
    .then((data) => {
      GUML_CACHE.set(key, { at: Date.now(), data });
      return data;
    })
    .catch((err: unknown) => {
      // Offline, with something to show: the last known data beats replacing a working screen with an
      // error. The caller is told it is stale so it can say so.
      const hit = GUML_CACHE.get(key);
      if (hit) return hit.data as T;
      throw err;
    })
    .finally(() => GUML_INFLIGHT.delete(key));
  GUML_INFLIGHT.set(key, request as Promise<unknown>);
  return request;
}

async function read<T>(url: string, init: RequestInit): Promise<T> {
  const res = await retrying(url, init);
  if (!res.ok) throw new Error(`Request failed: ${res.status}`);
  return (await res.json()) as T;
}

const FILTER_OPTIONS = ["all", "open", "done"] as const;

export default function Tasks() {
  const [draft, setDraft] = useState("");
  const [filter, setFilter] = useState<"all" | "open" | "done">("all");

  // resource `tasks`
  const [tasks, setTasks] = useState<Task[]>([]);
  const [tasksLoading, setTasksLoading] = useState(true);
  const [tasksError, setTasksError] = useState<string | null>(null);
  const [tasksSaving, setTasksSaving] = useState(false);

  const tasksList = useCallback(() => {
    const controller = new AbortController();
    let alive = true;
    setTasksLoading(true);
    setTasksError(null);
    cached<Task[]>("/api/tasks", { signal: controller.signal })
      .then((rows) => {
        if (alive) setTasks(rows);
      })
      .catch((err: unknown) => {
        if (!alive || (err instanceof Error && err.name === "AbortError")) return;
        setTasksError(err instanceof Error ? err.message : "Unknown error");
      })
      .finally(() => {
        if (alive) setTasksLoading(false);
      });
    return () => {
      alive = false;
      controller.abort();
    };
  }, []);

  useEffect(tasksList, [tasksList]);

  const tasksAdd = useCallback(
    async (body: Partial<Task>) => {
      const snapshot = tasks;
      setTasksSaving(true);
      const optimistic = { id: `tmp-${Date.now()}`, ...body } as Task;
      setTasks((prev) => [optimistic, ...prev]);
      try {
        const res = await retrying("/api/tasks", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error(`Request failed: ${res.status}`);
        invalidate("/api/tasks");
        const created = (await res.json()) as Task;
        setTasks((prev) => prev.map((it) => (it === optimistic ? created : it)));
      } catch (err: unknown) {
        setTasks(snapshot);
        setTasksError(err instanceof Error ? err.message : "Could not save");
      } finally {
        setTasksSaving(false);
      }
    },
    [tasks],
  );

  const tasksSave = useCallback(
    async (item: Task, body: Partial<Task> = {}) => {
      const snapshot = tasks;
      setTasksSaving(true);
      setTasks((prev) => prev.map((it) => (it === item ? { ...it, ...body } : it)));
      try {
        const res = await retrying(`/api/tasks/${item.id}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error(`Request failed: ${res.status}`);
        invalidate("/api/tasks");
      } catch (err: unknown) {
        setTasks(snapshot);
        setTasksError(err instanceof Error ? err.message : "Could not save");
      } finally {
        setTasksSaving(false);
      }
    },
    [tasks],
  );

  const tasksDrop = useCallback(
    async (item: Task, body: Partial<Task> = {}) => {
      const snapshot = tasks;
      setTasksSaving(true);
      setTasks((prev) => prev.filter((it) => it !== item));
      try {
        const res = await retrying(`/api/tasks/${item.id}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error(`Request failed: ${res.status}`);
        invalidate("/api/tasks");
      } catch (err: unknown) {
        setTasks(snapshot);
        setTasksError(err instanceof Error ? err.message : "Could not save");
      } finally {
        setTasksSaving(false);
      }
    },
    [tasks],
  );

  const visibleTasks = useMemo(
    () =>
      filter === "open"
        ? tasks.filter((it) => !it.done)
        : filter === "done"
          ? tasks.filter((it) => it.done)
          : tasks,
    [tasks, filter],
  );

  return (
    <>
      <p className="text-2xl font-semibold text-slate-900 dark:text-slate-100">Tasks — {tasks.filter((it) => !it.done).length} open</p>
      <form className="mt-6 flex gap-2" onSubmit={(e) => { e.preventDefault(); tasksAdd({ title: draft }); setDraft(""); }}>
        <input className="flex-1 rounded-md border border-slate-300 dark:border-slate-700 px-3 py-2 text-sm outline-none bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-slate-900 dark:focus:ring-slate-100 disabled:opacity-40" type="text" aria-label="New task" placeholder="Add a task…" value={draft} onChange={(e) => setDraft(e.target.value)} />
        <button className="rounded-md px-4 py-2 text-sm font-medium transition-colors bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-200 focus:ring-2 focus:ring-slate-900 dark:focus:ring-slate-100 disabled:opacity-40" type="submit" disabled={!draft.trim()}>{tasksSaving ? "Adding…" : "Add"}</button>
      </form>
      <div className="mt-4 flex gap-2">
        {FILTER_OPTIONS.map((option) => (
          <button
            key={option}
            type="button"
            aria-pressed={filter === option}
            onClick={() => setFilter(option)}
            className={
              filter === option
                ? "rounded-full bg-slate-900 px-3 py-1 text-xs font-medium text-white"
                : "rounded-full border border-slate-300 px-3 py-1 text-xs text-slate-600"
            }
          >
            {option}
          </button>
        ))}
      </div>
      {tasksError && (
        <p role="alert" className="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
          {tasksError}
        </p>
      )}
      {tasksLoading ? (
        <ul className="mt-6 space-y-2">
          {[0, 1, 2].map((n) => (
            <li key={n} className="h-12 animate-pulse rounded-md bg-slate-100" />
          ))}
        </ul>
      ) : visibleTasks.length === 0 ? (
        <p className="mt-10 text-center text-sm text-slate-500 dark:text-slate-400">Nothing here yet.</p>
      ) : (
        <ul className="mt-6 divide-y divide-slate-200 dark:divide-slate-800 rounded-md border border-slate-200 dark:border-slate-800">
          {visibleTasks.map((item, i) => (
            <li key={item.id} className="flex items-center gap-3 px-3 py-3">
              <input className="h-4 w-4 rounded border-slate-300 dark:border-slate-700 focus:ring-2 focus:ring-slate-900 dark:focus:ring-slate-100 disabled:opacity-40" type="checkbox" checked={item.done} aria-label={item.title} onChange={() => { tasksSave(item, { done: !item.done }); }} />
              <span className={`flex-1 text-sm text-slate-900 dark:text-slate-100 ${item.done ? "line-through text-slate-400" : ""}`}>{item.title}</span>
              <button className="rounded-md px-4 py-2 text-sm font-medium transition-colors text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 focus:ring-2 focus:ring-slate-900 dark:focus:ring-slate-100 disabled:opacity-40" type="button" aria-label={`Delete ${item.title}`} onClick={() => { tasksDrop(item, {}); }}>Delete</button>
            </li>
          ))}
        </ul>
      )}
    </>
  );
}
