{
  "name": "@guml/shadcn",
  "version": "0.2.0",
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.84.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "description": "Every shadcn/ui component, plus the GUML registry that makes them a vocabulary a model can write.",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./registry": "./guml.registry.json",
    "./ui/*": {
      "types": "./src/components/ui/*.tsx",
      "import": "./src/components/ui/*.tsx"
    },
    "./theme": "./guml.theme.json"
  },
  "files": [
    "src",
    "guml.registry.json",
    "guml.theme.json",
    "components.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "audit": "cargo run -q -p guml-cli -- registry --validate .",
    "typecheck:example": "node scripts/typecheck-example.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guml-lang/guml.git",
    "directory": "packages/guml-shadcn"
  },
  "homepage": "https://guml.vercel.app",
  "bugs": {
    "url": "https://github.com/guml-lang/guml/issues"
  },
  "author": "GUML contributors",
  "publishConfig": {
    "access": "public"
  }
}
