# Copy to `.env.local` and fill in. `.gitignore` covers `.env*`, so `.env.local` is
# never committed — keep it that way.

# A key from https://build.nvidia.com.
#
# Read only by the server-side route handlers in `app/api/chat/`. It is never sent to
# the browser, and must never be renamed to `NEXT_PUBLIC_*` — that prefix inlines a
# value into the client bundle, which for a credential means publishing it.
NVIDIA_API_KEY=

# Optional. Pins one model instead of the default in `app/api/chat/models.ts`.
# The picker lists whatever the key can actually reach; see /api/chat/models.
NVIDIA_MODEL=

# Optional. Points the chat at a self-hosted NIM instead of build.nvidia.com — also how
# the rate limiter is tested without spending credits.
NVIDIA_BASE_URL=

# Optional. Signs the demo-quota cookie. Falls back to a value derived from the API key,
# so the demo works without setting it; set it to keep quotas stable across key rotation.
DEMO_COOKIE_SECRET=
